POSTGRES_HOST=localhost
POSTGRES_USER=taskly
POSTGRES_PASSWORD=taskly
POSTGRES_DB=taskly
DB_PORT=5432
API_PORT=8000
WEB_PORT=8080

# Optional local override; otherwise the URL is built from the values above.
# DATABASE_URL=postgresql+psycopg://taskly:taskly@localhost:5432/taskly

# --- Unit-test agent (make pipeline / make backfill) ---------------------------
# Read by .github/agent-scripts/pipeline.py (KEY=value). A non-empty shell variable wins.
# Credentials go only to the agent process. One of them is required for the agent stage.
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# UTA_USE_LOCAL_LOGIN=1

# UTA_MODEL=claude-opus-5-5
# Backfill covers the whole repo (~13 untested files): needs more targets, budget and time
# than a PR run (PR defaults: 8 targets, $5, 1500 s).
UTA_MAX_TARGETS=15
UTA_MAX_BUDGET_USD=15
UTA_AGENT_TIMEOUT=3000
UTA_MAX_CHANGED_LINES=1500
UTA_REPEAT=3
# CLAUDE_BIN=claude
